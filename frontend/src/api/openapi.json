{
  "components" : {
    "schemas" : {
      "AcceptRequest" : {
        "properties" : {
          "name" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 72,
            "minLength" : 8,
            "type" : "string"
          }
        },
        "required" : [ "name", "password" ],
        "type" : "object"
      },
      "Group" : {
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "name" ],
        "type" : "object"
      },
      "InvitationResponse" : {
        "properties" : {
          "email" : {
            "type" : "string"
          }
        },
        "required" : [ "email" ],
        "type" : "object"
      },
      "InviteRequest" : {
        "properties" : {
          "email" : {
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0,
            "type" : "string"
          },
          "role" : {
            "enum" : [ "agent", "admin" ],
            "pattern" : "agent|admin",
            "type" : "string"
          }
        },
        "required" : [ "email", "role" ],
        "type" : "object"
      },
      "LoginRequest" : {
        "properties" : {
          "email" : {
            "minLength" : 1,
            "type" : "string"
          },
          "password" : {
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "email", "password" ],
        "type" : "object"
      },
      "MeResponse" : {
        "properties" : {
          "email" : {
            "type" : "string"
          },
          "groups" : {
            "items" : {
              "$ref" : "#/components/schemas/Group"
            },
            "type" : "array"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "role" : {
            "enum" : [ "requester", "agent", "admin" ],
            "type" : "string"
          }
        },
        "required" : [ "email", "groups", "id", "name", "role" ],
        "type" : "object"
      },
      "NewPasswordRequest" : {
        "properties" : {
          "password" : {
            "maxLength" : 72,
            "minLength" : 8,
            "type" : "string"
          }
        },
        "required" : [ "password" ],
        "type" : "object"
      },
      "RegisterRequest" : {
        "properties" : {
          "email" : {
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0,
            "type" : "string"
          },
          "name" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 72,
            "minLength" : 8,
            "type" : "string"
          }
        },
        "required" : [ "email", "name", "password" ],
        "type" : "object"
      },
      "ResetRequest" : {
        "properties" : {
          "email" : {
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "email" ],
        "type" : "object"
      },
      "SettingsRequest" : {
        "properties" : {
          "allowedDomains" : {
            "items" : {
              "minLength" : 1,
              "pattern" : "^@?[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$",
              "type" : "string"
            },
            "maxItems" : 50,
            "minItems" : 0,
            "type" : "array"
          },
          "name" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "requesterSignup" : {
            "enum" : [ "open", "domain_restricted" ],
            "pattern" : "open|domain_restricted",
            "type" : "string"
          }
        },
        "required" : [ "allowedDomains", "name", "requesterSignup" ],
        "type" : "object"
      },
      "SettingsResponse" : {
        "properties" : {
          "allowedDomains" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "name" : {
            "type" : "string"
          },
          "requesterSignup" : {
            "enum" : [ "open", "domain_restricted" ],
            "type" : "string"
          }
        },
        "required" : [ "allowedDomains", "name", "requesterSignup" ],
        "type" : "object"
      },
      "SignupRequest" : {
        "properties" : {
          "adminName" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "email" : {
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 72,
            "minLength" : 8,
            "type" : "string"
          },
          "slug" : {
            "minLength" : 1,
            "pattern" : "^[a-z0-9][a-z0-9-]{1,30}[a-z0-9]$",
            "type" : "string"
          },
          "tenantName" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "adminName", "email", "password", "slug", "tenantName" ],
        "type" : "object"
      },
      "SignupResponse" : {
        "properties" : {
          "me" : {
            "$ref" : "#/components/schemas/MeResponse"
          },
          "slug" : {
            "type" : "string"
          }
        },
        "required" : [ "me", "slug" ],
        "type" : "object"
      },
      "TenantInfo" : {
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "requesterSignup" : {
            "enum" : [ "open", "domain_restricted" ],
            "type" : "string"
          },
          "slug" : {
            "type" : "string"
          }
        },
        "required" : [ "name", "requesterSignup", "slug" ],
        "type" : "object"
      },
      "VerifyRequest" : {
        "properties" : {
          "token" : {
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "token" ],
        "type" : "object"
      }
    }
  },
