{
  "components" : {
    "schemas" : {
      "AcceptRequest" : {
        "properties" : {
          "name" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 72,
            "minLength" : 8,
            "type" : "string"
          }
        },
        "required" : [ "name", "password" ],
        "type" : "object"
      },
      "AddCommentRequest" : {
        "properties" : {
          "body" : {
            "maxLength" : 65536,
            "minLength" : 0,
            "type" : "string"
          },
          "public" : {
            "type" : "boolean"
          },
          "ticket" : {
            "$ref" : "#/components/schemas/UpdateTicketRequest"
          }
        },
        "required" : [ "body", "public" ],
        "type" : "object"
      },
      "ChangeSetResponse" : {
        "properties" : {
          "actor" : {
            "anyOf" : [ {
              "$ref" : "#/components/schemas/Named"
            }, {
              "type" : "null"
            } ]
          },
          "changeId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "changes" : {
            "items" : {
              "$ref" : "#/components/schemas/FieldChangeResponse"
            },
            "type" : "array"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          }
        },
        "required" : [ "actor", "changeId", "changes", "createdAt" ],
        "type" : "object"
      },
      "CommentAdded" : {
        "properties" : {
          "comment" : {
            "$ref" : "#/components/schemas/CommentResponse"
          },
          "ticket" : {
            "$ref" : "#/components/schemas/TicketResponse"
          }
        },
        "required" : [ "comment", "ticket" ],
        "type" : "object"
      },
      "CommentResponse" : {
        "properties" : {
          "author" : {
            "$ref" : "#/components/schemas/Named"
          },
          "body" : {
            "type" : "string"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "public" : {
            "type" : "boolean"
          }
        },
        "required" : [ "author", "body", "createdAt", "id", "public" ],
        "type" : "object"
      },
      "ConditionDto" : {
        "properties" : {
          "field" : {
            "enum" : [ "status", "priority", "type", "assignee", "group", "tags", "created_at", "updated_at" ],
            "minLength" : 1,
            "type" : "string"
          },
          "op" : {
            "enum" : [ "in", "not_in", "eq", "is_null", "is_not_null", "has_any", "has_all", "within_days", "older_than_days" ],
            "minLength" : 1,
            "type" : "string"
          },
          "value" : {
            "description" : "演算子による。in・has_any などは文字列の配列、eq は ID か @me、within_days は日数。is_null では省略"
          }
        },
        "required" : [ "field", "op", "value" ],
        "type" : "object"
      },
      "ConditionsDto" : {
        "properties" : {
          "all" : {
            "items" : {
              "$ref" : "#/components/schemas/ConditionDto"
            },
            "maxItems" : 20,
            "minItems" : 0,
            "type" : "array"
          }
        },
        "required" : [ "all" ],
        "type" : "object"
      },
      "CreateGroupRequest" : {
        "properties" : {
          "name" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "name" ],
        "type" : "object"
      },
      "CreateTicketRequest" : {
        "properties" : {
          "assigneeId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "body" : {
            "maxLength" : 65536,
            "minLength" : 0,
            "type" : "string"
          },
          "groupId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "priority" : {
            "default" : "normal",
            "enum" : [ "low", "normal", "high", "urgent" ],
            "pattern" : "low|normal|high|urgent",
            "type" : "string"
          },
          "requesterId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "subject" : {
            "maxLength" : 250,
            "minLength" : 0,
            "type" : "string"
          },
          "tags" : {
            "items" : {
              "maxLength" : 50,
              "minLength" : 0,
              "type" : "string"
            },
            "maxItems" : 20,
            "minItems" : 0,
            "type" : "array"
          },
          "type" : {
            "default" : "question",
            "enum" : [ "question", "incident", "problem", "task" ],
            "pattern" : "question|incident|problem|task",
            "type" : "string"
          }
        },
        "required" : [ "body", "requesterId", "subject" ],
        "type" : "object"
      },
      "EventsResponse" : {
        "properties" : {
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/ChangeSetResponse"
            },
            "type" : "array"
          }
        },
        "required" : [ "items" ],
        "type" : "object"
      },
      "FieldChangeResponse" : {
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "from" : {
            "description" : "変更前の値。文字列、文字列の配列、{id, name} など項目による"
          },
          "to" : {
            "description" : "変更後の値"
          }
        },
        "required" : [ "field", "from", "to" ],
        "type" : "object"
      },
      "Group" : {
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "name" ],
        "type" : "object"
      },
      "GroupCreated" : {
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "name" ],
        "type" : "object"
      },
      "GroupResponse" : {
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "members" : {
            "items" : {
              "$ref" : "#/components/schemas/Member"
            },
            "type" : "array"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "members", "name" ],
        "type" : "object"
      },
      "InvitationResponse" : {
        "properties" : {
          "email" : {
            "type" : "string"
          }
        },
        "required" : [ "email" ],
        "type" : "object"
      },
      "InviteRequest" : {
        "properties" : {
          "email" : {
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0,
            "type" : "string"
          },
          "role" : {
            "enum" : [ "agent", "admin" ],
            "pattern" : "agent|admin",
            "type" : "string"
          }
        },
        "required" : [ "email", "role" ],
        "type" : "object"
      },
      "LoginRequest" : {
        "properties" : {
          "email" : {
            "minLength" : 1,
            "type" : "string"
          },
          "password" : {
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "email", "password" ],
        "type" : "object"
      },
      "MeResponse" : {
        "properties" : {
          "email" : {
            "type" : "string"
          },
          "groups" : {
            "items" : {
              "$ref" : "#/components/schemas/Group"
            },
            "type" : "array"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "role" : {
            "enum" : [ "requester", "agent", "admin" ],
            "type" : "string"
          }
        },
        "required" : [ "email", "groups", "id", "name", "role" ],
        "type" : "object"
      },
      "Member" : {
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "name" ],
        "type" : "object"
      },
      "MembersRequest" : {
        "properties" : {
          "userIds" : {
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "maxItems" : 500,
            "minItems" : 0,
            "type" : "array"
          }
        },
        "required" : [ "userIds" ],
        "type" : "object"
      },
      "Named" : {
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "name" ],
        "type" : "object"
      },
      "NewPasswordRequest" : {
        "properties" : {
          "password" : {
            "maxLength" : 72,
            "minLength" : 8,
            "type" : "string"
          }
        },
        "required" : [ "password" ],
        "type" : "object"
      },
      "RegisterRequest" : {
        "properties" : {
          "email" : {
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0,
            "type" : "string"
          },
          "name" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 72,
            "minLength" : 8,
            "type" : "string"
          }
        },
        "required" : [ "email", "name", "password" ],
        "type" : "object"
      },
      "ResetRequest" : {
        "properties" : {
          "email" : {
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "email" ],
        "type" : "object"
      },
      "SettingsRequest" : {
        "properties" : {
          "allowedDomains" : {
            "items" : {
              "minLength" : 1,
              "pattern" : "^@?[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$",
              "type" : "string"
            },
            "maxItems" : 50,
            "minItems" : 0,
            "type" : "array"
          },
          "name" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "requesterSignup" : {
            "enum" : [ "open", "domain_restricted" ],
            "pattern" : "open|domain_restricted",
            "type" : "string"
          }
        },
        "required" : [ "allowedDomains", "name", "requesterSignup" ],
        "type" : "object"
      },
      "SettingsResponse" : {
        "properties" : {
          "allowedDomains" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "name" : {
            "type" : "string"
          },
          "requesterSignup" : {
            "enum" : [ "open", "domain_restricted" ],
            "type" : "string"
          }
        },
        "required" : [ "allowedDomains", "name", "requesterSignup" ],
        "type" : "object"
      },
      "SignupRequest" : {
        "properties" : {
          "adminName" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "email" : {
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 72,
            "minLength" : 8,
            "type" : "string"
          },
          "slug" : {
            "minLength" : 1,
            "pattern" : "^[a-z0-9][a-z0-9-]{1,30}[a-z0-9]$",
            "type" : "string"
          },
          "tenantName" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "adminName", "email", "password", "slug", "tenantName" ],
        "type" : "object"
      },
      "SignupResponse" : {
        "properties" : {
          "me" : {
            "$ref" : "#/components/schemas/MeResponse"
          },
          "slug" : {
            "type" : "string"
          }
        },
        "required" : [ "me", "slug" ],
        "type" : "object"
      },
      "SortDto" : {
        "properties" : {
          "direction" : {
            "enum" : [ "asc", "desc" ],
            "minLength" : 1,
            "pattern" : "asc|desc",
            "type" : "string"
          },
          "field" : {
            "enum" : [ "number", "subject", "status", "priority", "type", "created_at", "updated_at" ],
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "direction", "field" ],
        "type" : "object"
      },
      "TenantInfo" : {
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "requesterSignup" : {
            "enum" : [ "open", "domain_restricted" ],
            "type" : "string"
          },
          "slug" : {
            "type" : "string"
          }
        },
        "required" : [ "name", "requesterSignup", "slug" ],
        "type" : "object"
      },
      "TicketListResponse" : {
        "properties" : {
          "items" : {
            "items" : {
              "$ref" : "#/components/schemas/TicketResponse"
            },
            "type" : "array"
          },
          "page" : {
            "format" : "int32",
            "type" : "integer"
          },
          "size" : {
            "format" : "int32",
            "type" : "integer"
          },
          "total" : {
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "items", "page", "size", "total" ],
        "type" : "object"
      },
      "TicketResponse" : {
        "properties" : {
          "assignee" : {
            "anyOf" : [ {
              "$ref" : "#/components/schemas/Named"
            }, {
              "type" : "null"
            } ]
          },
          "closedAt" : {
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "followUpOf" : {
            "format" : "int64",
            "type" : [ "integer", "null" ]
          },
          "group" : {
            "anyOf" : [ {
              "$ref" : "#/components/schemas/Named"
            }, {
              "type" : "null"
            } ]
          },
          "number" : {
            "format" : "int64",
            "type" : "integer"
          },
          "priority" : {
            "enum" : [ "low", "normal", "high", "urgent" ],
            "type" : "string"
          },
          "requester" : {
            "$ref" : "#/components/schemas/Named"
          },
          "solvedAt" : {
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "status" : {
            "enum" : [ "new", "open", "pending", "on_hold", "solved", "closed" ],
            "type" : "string"
          },
          "subject" : {
            "type" : "string"
          },
          "tags" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "type" : {
            "enum" : [ "question", "incident", "problem", "task" ],
            "type" : "string"
          },
          "updatedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "version" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "assignee", "closedAt", "createdAt", "followUpOf", "group", "number", "priority", "requester", "solvedAt", "status", "subject", "tags", "type", "updatedAt", "version" ],
        "type" : "object"
      },
      "UpdateTicketRequest" : {
        "properties" : {
          "assigneeId" : {
            "description" : "null で担当者を外す。省略すると変えない",
            "format" : "uuid",
            "type" : [ "string", "null" ]
          },
          "groupId" : {
            "description" : "null で担当グループを外す。省略すると変えない",
            "format" : "uuid",
            "type" : [ "string", "null" ]
          },
          "priority" : {
            "enum" : [ "low", "normal", "high", "urgent" ],
            "pattern" : "low|normal|high|urgent",
            "type" : "string"
          },
          "status" : {
            "enum" : [ "new", "open", "pending", "on_hold", "solved", "closed" ],
            "pattern" : "new|open|pending|on_hold|solved|closed",
            "type" : "string"
          },
          "subject" : {
            "maxLength" : 250,
            "minLength" : 1,
            "type" : "string"
          },
          "tags" : {
            "items" : {
              "maxLength" : 50,
              "minLength" : 0,
              "type" : "string"
            },
            "maxItems" : 20,
            "minItems" : 0,
            "type" : "array"
          },
          "type" : {
            "enum" : [ "question", "incident", "problem", "task" ],
            "pattern" : "question|incident|problem|task",
            "type" : "string"
          },
          "version" : {
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "version" ],
        "type" : "object"
      },
      "UserSummary" : {
        "properties" : {
          "email" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "role" : {
            "enum" : [ "requester", "agent", "admin" ],
            "type" : "string"
          }
        },
        "required" : [ "email", "id", "name", "role" ],
        "type" : "object"
      },
      "VerifyRequest" : {
        "properties" : {
          "token" : {
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "token" ],
        "type" : "object"
      },
      "ViewRequest" : {
        "properties" : {
          "conditions" : {
            "$ref" : "#/components/schemas/ConditionsDto"
          },
          "name" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "shared" : {
            "description" : "true で共有ビューにする（管理者のみ）。作成時だけ使う",
            "type" : "boolean"
          },
          "sort" : {
            "items" : {
              "$ref" : "#/components/schemas/SortDto"
            },
            "maxItems" : 3,
            "minItems" : 0,
            "type" : "array"
          }
        },
        "required" : [ "conditions", "name" ],
        "type" : "object"
      },
      "ViewResponse" : {
        "properties" : {
          "conditions" : {
            "$ref" : "#/components/schemas/ConditionsDto"
          },
          "count" : {
            "format" : "int64",
            "type" : [ "integer", "null" ]
          },
          "id" : {
            "type" : "string"
          },
          "kind" : {
            "enum" : [ "builtin", "shared", "personal" ],
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "sort" : {
            "items" : {
              "$ref" : "#/components/schemas/SortDto"
            },
            "type" : "array"
          }
        },
        "required" : [ "conditions", "count", "id", "kind", "name", "sort" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "title" : "like-zendesk API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/csrf" : {
      "get" : {
        "operationId" : "csrf",
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "tags" : [ "session-controller" ]
      }
    },
    "/api/t/{slug}" : {
      "get" : {
        "operationId" : "get_2",
        "parameters" : [ {
          "in" : "path",
          "name" : "slug",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TenantInfo"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "tenant-controller" ]
      }
    },
    "/api/t/{slug}/admin/groups" : {
      "post" : {
        "operationId" : "createGroup",
        "parameters" : [ {
          "in" : "path",
          "name" : "slug",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateGroupRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/GroupCreated"
                }
              }
            },
            "description" : "Created"
          }
        },
        "tags" : [ "directory-controller" ]
      }
    },
    "/api/t/{slug}/admin/groups/{id}/members" : {
      "put" : {
        "operationId" : "replaceMembers",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "slug",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/MembersRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "tags" : [ "directory-controller" ]
      }
    },
    "/api/t/{slug}/admin/invitations" : {
      "post" : {
        "operationId" : "invite",
        "parameters" : [ {
          "in" : "path",
          "name" : "slug",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
